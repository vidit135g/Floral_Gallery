<?xml version="1.0" encoding="utf-8"?>
<com.absolute.floral.ui.widget.DismissFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/drag_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--Using HackyViewPager to prevent crashes with PhotoView-->
        <com.absolute.floral.ui.widget.HackyViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <View
        android:id="@+id/scrim_top"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:background="@drawable/dark_to_transparent_gradient" />

    <View
        android:id="@+id/scrim_bottom"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="bottom"
        android:background="@drawable/transparent_to_dark_gradient" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent" />

    <include layout="@layout/photo_view_button_bar" />
</com.absolute.floral.ui.widget.DismissFrameLayout>
