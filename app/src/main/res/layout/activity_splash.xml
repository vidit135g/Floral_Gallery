<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/mainl"
    android:layout_height="match_parent"
    android:background="@drawable/soma_onboard_bg"
    tools:context="com.absolute.floral.ui.SplashActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello"
        android:textSize="15sp"
        android:letterSpacing="0.18"
        android:fontFamily="@font/poppins_medium"
        android:id="@+id/hello"
        android:layout_marginTop="72dp"
        android:textColor="#73231F1A"
        android:layout_centerHorizontal="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true">

        <ImageView
            android:id="@+id/pixelimage"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your photos, at home"
            android:textSize="26sp"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:fontFamily="@font/fraunces_semibold"
            android:textColor="#231F1A" />

        <TextView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:text="Everything on your device — timelines, memories, albums and people. No account, nothing uploaded."
            android:textSize="13sp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="#B0231F1A" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:id="@+id/intro"
        android:visibility="gone"
        android:layout_centerHorizontal="true" />

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:text="Get started"
        android:textSize="15sp"
        android:paddingHorizontal="42dp"
        android:fontFamily="@font/poppins_medium"
        android:id="@+id/pixelbutton"
        android:textColor="#FDF7EE"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="44dp"
        android:background="@drawable/soma_pill_btn"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:layout_centerHorizontal="true" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="horizontal">
        <fr.castorflex.android.circularprogressbar.CircularProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true"
            app:cpb_color="#E99274"
            android:visibility="gone"
            app:cpb_colors="@array/progress_colors"
            app:cpb_rotation_speed="1.0"
            android:id="@+id/loading_spinner"
            app:cpb_sweep_speed="1.0"
            app:cpb_stroke_width="2dp"
            android:layout_marginEnd="8dp"
            app:cpb_min_sweep_angle="10"
            app:cpb_max_sweep_angle="300" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reading your library…"
            android:id="@+id/progresstext"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_regular"
            android:visibility="gone"
            android:textColor="#73231F1A" />
    </LinearLayout>

</RelativeLayout>
