<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/mainl"
    android:layout_height="match_parent"
    android:background="@drawable/soma_onboard_bg"
    tools:context="com.absolute.floral.ui.SplashActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WELCOME TO"
        android:textSize="12sp"
        android:letterSpacing="0.25"
        android:id="@+id/hello"
        android:layout_marginTop="76dp"
        android:textColor="#8A3B3A3E"
        android:layout_centerHorizontal="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="34dp"
        android:layout_centerInParent="true">

        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp">
            <View
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/splash_glow" />
            <ImageView
                android:id="@+id/pixelimage"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:src="@mipmap/ic_launcher" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Floral"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp"
            android:letterSpacing="-0.01"
            android:textColor="#2A2930" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your whole photo library — a bento of memories, people, places and colours. Every pixel stays on your device."
            android:textSize="14sp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:textColor="#7A3B3A3E" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/intro"
        android:visibility="gone"
        android:layout_centerHorizontal="true" />

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Get started"
        android:textSize="15sp"
        android:layout_marginHorizontal="22dp"
        android:id="@+id/pixelbutton"
        android:textColor="#FFFFFF"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="38dp"
        android:background="@drawable/soma_pill_btn"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:layout_centerHorizontal="true" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="horizontal">
        <fr.castorflex.android.circularprogressbar.CircularProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true"
            app:cpb_color="#B57BC7"
            android:visibility="gone"
            app:cpb_colors="@array/progress_colors"
            app:cpb_rotation_speed="1.0"
            android:id="@+id/loading_spinner"
            app:cpb_sweep_speed="1.0"
            app:cpb_stroke_width="2dp"
            android:layout_marginEnd="8dp"
            app:cpb_min_sweep_angle="10"
            app:cpb_max_sweep_angle="300" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reading your library…"
            android:id="@+id/progresstext"
            android:textSize="13sp"
            android:visibility="gone"
            android:textColor="#7A3B3A3E" />
    </LinearLayout>

</RelativeLayout>
