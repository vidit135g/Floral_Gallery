<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- dawn gradient — coral → rose → periwinkle, top-left to bottom-right -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="6" android:startY="0"
                android:endX="102" android:endY="108"
                android:type="linear">
                <item android:offset="0.0"  android:color="#FFFF9E7A" />
                <item android:offset="0.42" android:color="#FFF06E9E" />
                <item android:offset="0.72" android:color="#FFB86BD0" />
                <item android:offset="1.0"  android:color="#FF7C6CE0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- warm top-left bloom -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="30" android:centerY="22" android:gradientRadius="82"
                android:type="radial">
                <item android:offset="0.0" android:color="#59FFF0D8" />
                <item android:offset="1.0" android:color="#00FFF0D8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- soft bottom vignette -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0" android:startY="66" android:endX="0" android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#00000000" />
                <item android:offset="1.0" android:color="#24000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
